www.{$DOMAIN} {
	import protected
	header {
		Cache-Control "public, max-age=10"
		import header_common
	}

	handle_errors {
		@notFound expression `{http.error.status_code} == 404`
		redir @notFound https://www.{$DOMAIN} permanent
	}

	reverse_proxy homepage:3000
}

{$DOMAIN} {
	import common
	redir https://www.{$DOMAIN}{uri} permanent
}

public.{$DOMAIN} {
	import common
	root * /public_data
	file_server browse

	header / {
		Cache-Control "no-store"
		import header_common
	}
}
