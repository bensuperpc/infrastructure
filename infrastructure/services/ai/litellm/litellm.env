DATABASE_URL=postgresql://litellm:${LITELLM_DB_PASSWORD:?run make init}@litellm-postgres:5432/litellm
# Must start with sk-; also openwebui's OPENAI_API_KEY
LITELLM_MASTER_KEY=sk-${LITELLM_MASTER_KEY:?run make init}
LITELLM_MODE=PRODUCTION
# Models are added in the UI (Models → Add Model), stored in the database
STORE_MODEL_IN_DB=True
UI_USERNAME=admin
UI_PASSWORD=${LITELLM_UI_PASSWORD:?run make init}
PROXY_BASE_URL=https://litellm.${DOMAIN}

#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
