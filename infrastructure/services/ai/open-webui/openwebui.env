OFFLINE_MODE=true
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-${LITELLM_MASTER_KEY:?run make init}
WEBUI_URL=https://openwebui.${DOMAIN}
CORS_ALLOW_ORIGIN=https://openwebui.${DOMAIN}
WEBUI_SECRET_KEY=${OPENWEBUI_SECRET_KEY:?run make init}
VECTOR_DB=pgvector
DATABASE_TYPE=postgresql
DATABASE_HOST=openwebui-postgres
DATABASE_PORT=5432
DATABASE_NAME=openwebui
DATABASE_USER=openwebui
DATABASE_PASSWORD=${OPENWEBUI_DB_PASSWORD:?run make init}
OLLAMA_BASE_URL=http://ollama:11434
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=${EMBEDDING_MODEL}
RAG_OLLAMA_BASE_URL=http://ollama:11434
CONTENT_EXTRACTION_ENGINE=docling
DOCLING_SERVER_URL=http://docling:5001

AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://speaches:8000/v1
AUDIO_STT_OPENAI_API_KEY=${SPEACHES_API_KEY:?run make init}
AUDIO_STT_MODEL=${SPEACHES_STT_MODEL}
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://speaches:8000/v1
AUDIO_TTS_OPENAI_API_KEY=${SPEACHES_API_KEY:?run make init}
AUDIO_TTS_MODEL=${SPEACHES_TTS_MODEL}
AUDIO_TTS_VOICE=${SPEACHES_TTS_VOICE}
