DOMAIN=${DOMAIN}
X_AUTHELIA_CONFIG_FILTERS=template
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=${AUTHELIA_JWT_SECRET:?run make init}
AUTHELIA_SESSION_SECRET=${AUTHELIA_SESSION_SECRET:?run make init}
AUTHELIA_STORAGE_ENCRYPTION_KEY=${AUTHELIA_STORAGE_ENCRYPTION_KEY:?run make init}
AUTHELIA_STORAGE_POSTGRES_ADDRESS=tcp://authelia-postgres:5432
AUTHELIA_STORAGE_POSTGRES_DATABASE=authelia_db
AUTHELIA_STORAGE_POSTGRES_USERNAME=authelia
AUTHELIA_STORAGE_POSTGRES_PASSWORD=${AUTHELIA_DB_PASSWORD:?run make init}
#AUTHELIA_NOTIFIER_SMTP_PASSWORD=your-smtp-password-here
