{
	key_type p384
	skip_install_trust

	log {
		output file /data/logs/access.log {
			roll_size 1GiB
			roll_keep 20
			roll_keep_for 720h
		}
		format json
	}
}

# Snippets: header_common, authelia_middleware
import snippets/*.caddy

# Access, in each website/*.caddy file:
# - public: no login
# - protected: Authelia login; admins only, unless the site is in the users list of Authelia's configuration.yml
# TLS=internal (local: Caddy's own CA) or TLS=acme-dns (online: Let's Encrypt wildcard)
(public) {
	import tls/{$TLS}.caddy
}

(protected) {
	import public
	import authelia_middleware
}

# import app <subdomain> <upstream>: site behind Authelia
(app) {
	{args[0]}.{$DOMAIN} {
		import protected
		header ?X-Frame-Options SAMEORIGIN
		reverse_proxy {args[1]}
	}
}

# import public_app <subdomain> <upstream>: site without login
(public_app) {
	{args[0]}.{$DOMAIN} {
		import public
		header ?X-Frame-Options SAMEORIGIN
		reverse_proxy {args[1]}
	}
}

import website/*.caddy
