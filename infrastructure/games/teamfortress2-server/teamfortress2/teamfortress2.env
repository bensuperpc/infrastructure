# Get a free Game Server Login Token from https://steamcommunity.com/dev/managegameservers
# Set TEAMFORTRESS2_SRCDS_TOKEN in infrastructure/.env
SRCDS_TOKEN=${TEAMFORTRESS2_SRCDS_TOKEN:?run make init}
SRCDS_PW=${TEAMFORTRESS2_SERVER_PW:?run make init}
SRCDS_PORT=27015
SRCDS_MAXPLAYERS=32
SRCDS_REGION=3
SRCDS_STARTMAP=pl_goldrush
#SRCDS_MAPCYCLE="mapcycle_default.txt"
#pl_badwater
SRCDS_CFG=server.cfg
SRCDS_SECURED=0
