COMPOSE_PROFILES=core,local_ai,openssh
PUID=1000
PGID=1000
TZ=Europe/Paris

# Online: your domain and TLS=acme-dns (Let's Encrypt wildcard certificate, see docs/configuration.md).
# Locally: a *.localhost domain (resolves to 127.0.0.1 without DNS) and TLS=internal (Caddy's own CA).
DOMAIN=bensuperpc.localhost
TLS=internal
# Address of every published port (Caddy, SSH, torrent, games): 0.0.0.0 online, 127.0.0.1 to keep a local test off the network
LISTEN_ADDRESS=127.0.0.1

# Authelia
AUTHELIA_ADMIN_USER=bensuperpc
AUTHELIA_ADMIN_EMAIL=bensuperpc@gmail.com
AUTHELIA_ADMIN_PASSWORD=__GENERATE__

# local_ai: chat model (opencode, openwebui) and embedding model (openwebui RAG)
OLLAMA_MODEL=gemma4:12b
EMBEDDING_MODEL=nomic-embed-text-v2-moe
LOCAL_AI_WORKSPACE=local_ai_workspace
LOCAL_AI_DOCS=local_ai_docs
# deepdml/faster-whisper-large-v3-turbo-ct2
SPEACHES_STT_MODEL=Systran/faster-whisper-small
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_TTS_VOICE=ff_siwis
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8

# acme-dns: Caddy's account for TLS=acme-dns, written by make acme-dns-register
ACME_DNS_USERNAME=
ACME_DNS_PASSWORD=
ACME_DNS_SUBDOMAIN=

# authelia
AUTHELIA_JWT_SECRET=__GENERATE__
AUTHELIA_SESSION_SECRET=__GENERATE__
AUTHELIA_STORAGE_ENCRYPTION_KEY=__GENERATE__
AUTHELIA_DB_PASSWORD=__GENERATE__

# caddy
CADDY_RESTIC_PASSWORD=__GENERATE__
# code-server
VSCODE_SERVER_PASSWORD=__GENERATE__
# dependency-track
DTRACK_DB_PASSWORD=__GENERATE__
# dufs
DUFS_PASSWORD=__GENERATE__
# forgejo
FORGEJO_DB_PASSWORD=__GENERATE__
FORGEJO_SECRET_KEY=__GENERATE__
FORGEJO_DB_ROOT_PASSWORD=__GENERATE__
FORGEJO_RUNNER_SECRET=__GENERATE_40__
# immich
IMMICH_DB_PASSWORD=__GENERATE__
# kiwix
OPENZIM_MCP_AUTH_TOKEN=__GENERATE__
# litellm
LITELLM_DB_PASSWORD=__GENERATE__
LITELLM_MASTER_KEY=__GENERATE__
LITELLM_UI_PASSWORD=__GENERATE__
# open-webui
OPENWEBUI_DB_PASSWORD=__GENERATE__
OPENWEBUI_SECRET_KEY=__GENERATE__
# openssh
OPENSSH_USER_PASSWORD=__GENERATE__
# picoshare
PICOSHARE_SHARED_SECRET=__GENERATE__
# projectsend
PROJECTSEND_DB_ROOT_PASSWORD=__GENERATE__
PROJECTSEND_DB_PASSWORD=__GENERATE__
# psitransfer
PSITRANSFER_ADMIN_PASS=__GENERATE__
# searxng
SEARXNG_SECRET=__GENERATE__
# SEARXNG_CONTACT_URL=
# speaches
SPEACHES_API_KEY=__GENERATE__
# stirlingpdf
STIRLINGPDF_LOGIN_PASSWORD=__GENERATE__
# syncthing: GUI user admin
SYNCTHING_GUI_PASSWORD=__GENERATE__
# transmission
TRANSMISSION_PASSWORD=__GENERATE__
# vllm
VLLM_API_KEY=__GENERATE__
# wordpress
WORDPRESS_DB_PASSWORD=__GENERATE__
WORDPRESS_RESTIC_PASSWORD=__GENERATE__
WORDPRESS_DB_ROOT_PASSWORD=__GENERATE__

# Steam Game Server Login Token, from https://steamcommunity.com/dev/managegameservers
TEAMFORTRESS2_SRCDS_TOKEN=CHANGEME_STEAM_GSLT_TOKEN

# games/7daystodie-server/backup
SEVENDAYSTODIE_RESTIC_PASSWORD=__GENERATE__
# games/minecraft-server/backup
MINECRAFT_RESTIC_PASSWORD=__GENERATE__
# games/minecraft-server/minecraft-server
MINECRAFT_PROXY_RCON_PASSWORD=__GENERATE__
MINECRAFT_RCON_PASSWORD=__GENERATE__
# games/satisfactory-server/backup
SATISFACTORY_RESTIC_PASSWORD=__GENERATE__
# games/teamfortress2-server/backup
TEAMFORTRESS2_RESTIC_PASSWORD=__GENERATE__
# games/teamfortress2-server/teamfortress2
TEAMFORTRESS2_SERVER_PW=__GENERATE__

# Optional GitHub token
ARGUS_GITHUB_TOKEN=
