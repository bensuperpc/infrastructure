{
    "qt-qml.qmlls.customExePath": "/usr/lib/qt6/bin/qmlls",
    "qt-qml.doNotAskForQmllsDownload": true,

    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Déboguer la cible CMake",
                "type": "lldb",
                "request": "launch",
                "program": "${command:cmake.launchTargetPath}",
                "cwd": "${workspaceFolder}"
            }
        ]
    }
}
