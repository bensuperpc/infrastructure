RESTIC_REPOSITORY=/mnt/restic
RESTIC_BACKUP_SOURCES=/data
#RUN_ON_STARTUP=true
# Backup, then forget and prune the old snapshots
BACKUP_CRON=*/20 * * * *
RESTIC_BACKUP_ARGS=--tag docker-volumes --verbose
RESTIC_FORGET_ARGS=--prune --keep-last 8 --keep-daily 7 --keep-weekly 5 --keep-monthly 12 --keep-yearly 4
# Check (exclusive with Backup and Prune)
#CHECK_CRON=*/30 * * * *
#RESTIC_CHECK_ARGS=--read-data-subset=40%
# Prune (exclusive with Backup and Check)
#PRUNE_CRON=*/30 * * * *
#RESTIC_PRUNE_ARGS=
